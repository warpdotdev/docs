---
// Custom "Ask" launcher beside the sidebar search pill (see CustomSidebar.astro).
// Opens Kapa's Website Widget via the JS API so we can hand off Pagefind queries.

const DEFAULT_KAPA_INTEGRATION_ID = 'f31c5644-dd65-4f49-9762-bf580062afa8';
const integrationId = DEFAULT_KAPA_INTEGRATION_ID;
// Public brand assets already served from this site.
const projectLogo = 'https://docs.warp.dev/apple-touch-icon.png';
// Matches the support destination used across Warp docs contact paths.
const handoffEmail = 'support@warp.dev';
---

{
	integrationId ? (
		<>
			<button
				type="button"
				class="warp-kapa-button"
				id="warp-kapa-button"
				aria-label="Ask AI"
				aria-haspopup="dialog"
				aria-keyshortcuts="Control+I Meta+I"
				data-tooltip="Ask AI"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
				</svg>
				<span class="warp-kapa-button__label">Ask</span>
			</button>

			{/* Queue Kapa calls before the async widget bundle finishes loading. */}
			<script is:inline>
				(function () {
					var k = window.Kapa;
					if (!k) {
						var i = function () {
							i.c(arguments);
						};
						i.q = [];
						i.c = function (args) {
							i.q.push(args);
						};
						window.Kapa = i;
					}
				})();
			</script>

			<script
				async
				src="https://widget.kapa.ai/kapa-widget.bundle.js"
				data-website-id={integrationId}
				data-project-name="Warp"
				data-project-color="#4BA3EB"
				data-project-color-dark="#B0C9FA"
				data-project-logo={projectLogo}
				data-modal-title="Ask AI"
				data-modal-title-ask-ai="Ask AI"
				data-ask-ai-input-placeholder="Ask a question about Warp…"
				data-view-mode="sidebar"
				data-launcher-button-hidden="true"
				data-modal-size="28rem"
				data-modal-overlay-hidden="true"
				data-modal-lock-scroll="false"
				data-modal-z-index="10000"
				data-modal-full-screen-on-mobile="true"
				data-color-scheme-selector="[data-theme='dark']"
				data-font-family="Inter, 'Inter Fallback', system-ui, sans-serif"
				data-surface-color="#ffffff"
				data-surface-elevated-color="#f3f3f3"
				data-surface-hover-color="#fafafa"
				data-text-color="#181d27"
				data-text-muted-color="#535862"
				data-border-color="#dbdbdb"
				data-anchor-color="#1479B8"
				data-surface-color-dark="#121212"
				data-surface-elevated-color-dark="#252b37"
				data-surface-hover-color-dark="#292929"
				data-text-color-dark="#fafafa"
				data-text-muted-color-dark="#a4a7ae"
				data-border-color-dark="#414651"
				data-anchor-color-dark="#B0C9FA"
				data-modal-content-border-radius="0"
				data-modal-content-border-left="1px solid #414651"
				data-modal-content-box-shadow="0 25px 50px -12px rgba(0, 0, 0, 0.45)"
				data-modal-content-border-left-dark="1px solid #414651"
				data-modal-header-background-color="transparent"
				data-modal-header-background-color-dark="transparent"
				data-modal-header-border-bottom="0"
				data-modal-header-padding-y="0.5rem"
				data-modal-header-padding-x="1rem"
				data-query-input-border-radius="4px"
				data-query-input-border="1px solid #dbdbdb"
				data-query-input-border-dark="1px solid #414651"
				data-query-input-background-color="#ffffff"
				data-query-input-background-color-dark="#121212"
				data-query-input-color="#181d27"
				data-query-input-color-dark="#fafafa"
				data-query-input-placeholder-color="#535862"
				data-query-input-placeholder-color-dark="#a4a7ae"
				data-query-input-focus-border-color="#1479B8"
				data-query-input-focus-border-color-dark="#B0C9FA"
				data-submit-button-background-color="#1479B8"
				data-submit-button-background-color-dark="#B0C9FA"
				data-submit-button-color="#ffffff"
				data-submit-button-color-dark="#121212"
				data-submit-button-border-radius="4px"
				data-submit-button-border="1px solid #1479B8"
				data-submit-button-border-dark="1px solid #B0C9FA"
				data-submit-button-hover-background-color="#1C4A73"
				data-submit-button-hover-background-color-dark="#c5d8fc"
				data-conversation-item-question-background-color="#1479B8"
				data-conversation-item-question-background-color-dark="#B0C9FA"
				data-conversation-item-question-color="#ffffff"
				data-conversation-item-question-color-dark="#121212"
				data-conversation-item-question-border-radius="8px"
				data-conversation-item-answer-background-color="#f3f3f3"
				data-conversation-item-answer-background-color-dark="#1c1f26"
				data-conversation-item-answer-color="#181d27"
				data-conversation-item-answer-color-dark="#dbdbdb"
				data-conversation-item-answer-border="1px solid #dbdbdb"
				data-conversation-item-answer-border-dark="1px solid #414651"
				data-conversation-item-answer-border-radius="8px"
				data-handoff-email={handoffEmail}
				data-handoff-button-text="Create ticket"
				data-handoff-triggers="always"
				data-handoff-button-border-radius="4px"
				data-handoff-button-border="1px solid #dbdbdb"
				data-handoff-button-border-dark="1px solid #414651"
				data-handoff-button-background-color="#ffffff"
				data-handoff-button-background-color-dark="#121212"
				data-handoff-button-color="#181d27"
				data-handoff-button-color-dark="#dbdbdb"
				data-handoff-button-hover-background-color="#fafafa"
				data-handoff-button-hover-background-color-dark="#292929"
				data-user-analytics-fingerprint-enabled="false"
			></script>

			<script is:inline>
				(function () {
					var button = document.getElementById('warp-kapa-button');
					if (!button) return;

					var isApple = /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform || '');
					var isOpen = false;
					button.setAttribute('aria-keyshortcuts', isApple ? 'Meta+I' : 'Control+I');
					button.setAttribute('data-tooltip', isApple ? 'Ask AI ⌘I' : 'Ask AI Ctrl+I');
					button.setAttribute('aria-expanded', 'false');

					function readSearchQuery() {
						var searchDialog = document.querySelector('site-search dialog');
						var pendingQuery;
						if (searchDialog && searchDialog.open) {
							var searchInput = searchDialog.querySelector('.pagefind-ui__search-input');
							pendingQuery = (searchInput && searchInput.value && searchInput.value.trim()) || undefined;
							searchDialog.close();
						}
						if (!pendingQuery && window.__warpAskAiQuery) {
							pendingQuery = window.__warpAskAiQuery;
							delete window.__warpAskAiQuery;
						}
						return pendingQuery;
					}

					function setOpenState(next) {
						isOpen = next;
						button.setAttribute('aria-expanded', next ? 'true' : 'false');
					}

					function isInsideKapaWidget(target) {
						if (!target || typeof target.closest !== 'function') return false;
						return !!target.closest(
							[
								'[id^="kapa-"]',
								'[class^="kapa-"]',
								'[class*=" kapa-"]',
								'[data-kapa-widget]',
								'[data-kapa-root]',
							].join(','),
						);
					}

					function openKapa(query) {
						var options = { mode: 'ai', submit: false };
						if (query) options.query = query;
						// Preinitialized queue form: safe before the bundle finishes loading.
						window.Kapa('open', options);
						setOpenState(true);
					}

					function closeKapa() {
						window.Kapa('close');
						setOpenState(false);
					}

					function onLaunch() {
						openKapa(readSearchQuery());
					}

					function onToggle() {
						if (isOpen) {
							closeKapa();
							return;
						}
						onLaunch();
					}

					button.addEventListener('click', onLaunch);

					window.Kapa('onModalOpen', function () {
						setOpenState(true);
					});
					window.Kapa('onModalClose', function () {
						setOpenState(false);
					});

					document.addEventListener(
						'pointerdown',
						function (event) {
							if (!isOpen) return;
							var target = event.target;
							if (!(target instanceof Element)) return;
							if (target.closest('#warp-kapa-button')) return;
							if (isInsideKapaWidget(target)) return;
							closeKapa();
						},
						true,
					);

					window.addEventListener('keydown', function (event) {
						var key = event.key && event.key.toLowerCase();
						if (key !== 'i') return;
						if (!(event.metaKey || event.ctrlKey) || event.altKey || event.shiftKey) return;
						event.preventDefault();
						onToggle();
					});
				})();
			</script>
		</>
	) : null
}
