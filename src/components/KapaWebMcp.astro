---
/**
 * Loads the Kapa Website Widget script solely so WebMCP can register the
 * read-only `search_warp_knowledge_sources` page tool for in-browser agents.
 *
 * Human chat stays on the custom React SDK surface (`KapaChatLauncher`).
 * This script hides Kapa's default floating button and does not replace or
 * duplicate the custom Ask launcher.
 *
 * @see https://docs.kapa.ai/integrations/website-widget/features/webmcp
 * @see https://www.kapa.ai/blog/kapa-webmcp
 */
import { PUBLIC_KAPA_INTEGRATION_ID } from 'astro:env/client';
import { getKapaWebMcpScriptAttributes } from '../lib/kapa-webmcp.js';

const attrs = getKapaWebMcpScriptAttributes(PUBLIC_KAPA_INTEGRATION_ID);
---

{
	attrs ? (
		<script
			is:inline
			async
			src={attrs.src}
			data-website-id={attrs['data-website-id']}
			data-project-name={attrs['data-project-name']}
			data-webmcp-enabled={attrs['data-webmcp-enabled']}
			data-button-hide={attrs['data-button-hide']}
		/>
	) : null
}
